{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Реєстр активностей (catalog.json)",
  "type": "object",
  "required": [
    "format",
    "lastmod",
    "taxonomy",
    "pages",
    "activities"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "types",
        "topics",
        "difficulty"
      ],
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "difficulty": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      },
      "description": "Дозволені ключі (порядок = порядок у фільтрах). Підписи мовами лежать у i18n/<lang>/home.json (filter.type.*, filter.topic.*, filter.level.*)"
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "path",
          "title",
          "description",
          "locales",
          "grades",
          "topics",
          "difficulty",
          "duration",
          "og",
          "card"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/([a-z0-9-]+/)*$"
          },
          "title": {
            "type": "object",
            "required": [
              "uk"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "description": {
            "type": "object",
            "required": [
              "uk"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "locales": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "uk",
                "en"
              ]
            }
          },
          "scripts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+\\.js$"
            }
          },
          "vendorScripts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^vendor/[A-Za-z0-9@._{}/-]+\\.js$"
            },
            "description": "Сторонні скрипти від кореня сайту; {lang} підставляється мовою сторінки. Якщо поле є, усі скрипти сторінки йдуть з defer"
          },
          "skin": {
            "type": "string",
            "enum": [
              "space",
              "own"
            ],
            "description": "own: власна шапка/підвал у page.html, без tokens.css/base.css від шаблону; space: те саме + темна космічна тема"
          },
          "themeColor": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "grades": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 11
            }
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "og": {
            "type": "string",
            "pattern": "^assets/og/[a-z0-9-]+\\.png$"
          },
          "favicon": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+\\.svg$",
            "description": "SVG-іконка вкладки в activities/<id>/; без поля — загальна іконка сайту"
          },
          "card": {
            "type": "object",
            "required": [
              "cover",
              "facts"
            ],
            "additionalProperties": false,
            "description": "Картка на головній. Тексти: i18n/<lang>/home.json, ключі card.<id>.subject|blurb|f1..fN|cta|note; малюнок: activities/<id>/card.svg",
            "properties": {
              "cover": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5,
                "description": "Колір обкладинки: клас b<N> у pages/home/home.css"
              },
              "facts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z-]+$"
                },
                "description": "Імена іконок із templates/icons.json"
              },
              "note": {
                "type": "boolean",
                "description": "Є дрібна підказка поруч із кнопкою (ключ card.<id>.note)"
              }
            }
          },
          "count": {
            "type": "object",
            "required": [
              "file",
              "path"
            ],
            "additionalProperties": false,
            "description": "Звідки брати кількість елементів для токенів {count.<id>} у рядках: файл контенту (можна {lang}) і шлях до масиву через крапку",
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^content/[A-Za-z0-9._{}/-]+\\.json$"
              },
              "path": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)*$"
              }
            }
          }
        }
      }
    },
    "lastmod": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Дата в <lastmod> sitemap.xml (стала, щоб збірка була відтворюваною)"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "description": "Сайтові сторінки з шаблону templates/page.html: тіло pages/<id>/page.html, словник i18n/<lang>/<namespace>.json",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "locales",
          "og"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^([a-z0-9-]+/)*$",
            "description": "Порожній рядок — корінь сайту (головна)"
          },
          "locales": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "uk",
                "en"
              ]
            }
          },
          "og": {
            "type": "string",
            "pattern": "^assets/og/[a-z0-9-]+\\.png$"
          },
          "css": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+\\.css$"
            },
            "description": "Додаткові стилі від кореня сайту (перед pages/<id>/<id>.css)"
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._/-]+\\.js$"
            },
            "description": "Скрипти від кореня сайту в потрібному порядку; i18n.js у списку вмикає блок #i18n-data"
          }
        }
      }
    }
  }
}
