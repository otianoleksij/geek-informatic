{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Рівні гри «Код Галактики» (content/kod-galaktyky/levels.json)",
  "type": "object",
  "required": ["format", "levels"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "story", "tip", "size", "map", "start", "maxBlocks", "par", "allowed", "limits", "solution"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Стабільний id (kebab-case): за ним зберігається прогрес і будується посилання #id" },
          "title": { "$ref": "#/definitions/text" },
          "story": { "$ref": "#/definitions/text" },
          "tip": { "$ref": "#/definitions/text" },
          "size": { "type": "integer", "minimum": 6, "maximum": 9, "description": "Сторона квадратного поля" },
          "map": {
            "type": "array", "minItems": 6, "maxItems": 9,
            "items": { "type": "string", "pattern": "^[.#S*]+$" },
            "description": "S старт, * кристал, # астероїд, . порожньо"
          },
          "start": {
            "type": "object", "required": ["dir"], "additionalProperties": false,
            "properties": { "dir": { "type": "string", "enum": ["E", "N", "W", "S"] } }
          },
          "maxBlocks": { "type": "integer", "minimum": 1 },
          "par": { "type": "integer", "minimum": 1 },
          "allowed": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["F", "L", "R", "C", "rep"] } },
          "limits": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "F": { "type": "integer", "minimum": 0 }, "L": { "type": "integer", "minimum": 0 },
              "R": { "type": "integer", "minimum": 0 }, "C": { "type": "integer", "minimum": 0 },
              "rep": { "type": "integer", "minimum": 0 }
            }
          },
          "solution": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } }
        }
      }
    }
  },
  "definitions": {
    "text": {
      "type": "object",
      "required": ["uk", "en"],
      "additionalProperties": { "type": "string", "pattern": "\\S" },
      "properties": { "uk": { "type": "string" }, "en": { "type": "string" } }
    },
    "node": {
      "oneOf": [
        { "type": "string", "enum": ["F", "L", "R", "C"] },
        {
          "type": "object",
          "required": ["rep", "body"],
          "additionalProperties": false,
          "properties": {
            "rep": { "type": "integer", "minimum": 2, "maximum": 9 },
            "body": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } }
          }
        }
      ]
    }
  }
}
